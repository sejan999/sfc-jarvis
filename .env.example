# ==============================================================
# SFC JARVIS - Environment Configuration
# Copy this file to `.env` and fill in your real API keys.
# NEVER commit the real `.env` file to version control.
# ==============================================================

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for conversations
GEMINI_MODEL=gemini-2.0-flash

# Optional: Custom search backend endpoint (defaults to DuckDuckGo Instant Answer)
SEARCH_API_URL=https://api.duckduckgo.com/